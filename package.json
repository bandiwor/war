{
  "name": "war",
  "version": "0.0.1",
  "private": true,
  "description": "War — a realistic first-person bodycam survival shooter for the browser. Everything procedural.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "bench": "tsx bench/run.ts",
    "headless": "tsx src/headless/cli.ts",
    "ci": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm run perf",
    "prepare": "git config core.hooksPath .githooks || true",
    "golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "perf": "tsx scripts/perf-gate.ts",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tinybench": "^6.2.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
